{
  "name": "subsaber",
  "private": true,
  "version": "1.0.0",
  "description": "Subsaber — passive subdomain discovery and HTTP status checks for authorized domains.",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "node scripts/build-static-css.mjs && node scripts/build-static.mjs",
    "start": "tsx server.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@tailwindcss/node": "^4.3.3",
    "@tailwindcss/oxide": "^4.3.3",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "tldts": "^7.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  }
}
